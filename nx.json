{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "useDaemonProcess": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**/*", "!{projectRoot}/coverage/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/test-types/**/*",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/tstyche.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/biome.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "check": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test:unit": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "test:types": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "coverage": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"]
    }
  },
  "analytics": false
}
