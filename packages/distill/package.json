{
  "name": "@satunnaisuus/distill",
  "version": "0.0.3",
  "description": "A type-safe DI container for TypeScript.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "pnpm run test:unit && pnpm run test:types",
    "test:unit": "vitest run",
    "test:types": "pnpm run build && tstyche",
    "coverage": "vitest run --coverage"
  },
  "nx": {
    "targets": {
      "test": {
        "parallelism": false
      },
      "test:types": {
        "parallelism": false
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/satunnaisuus/distill.git",
    "directory": "packages/distill"
  },
  "keywords": [],
  "author": "satunnaisuus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/satunnaisuus/distill/issues"
  },
  "homepage": "https://github.com/satunnaisuus/distill#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@vitest/coverage-v8": "^4.1.5",
    "tsdown": "^0.21.10",
    "tstyche": "^7.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
