{
  "name": "@satunnaisuus/distill",
  "version": "0.0.1",
  "description": "A type-safe DI container for TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepack": "npm run build",
    "test": "npm run test:types",
    "test:types": "npm run build && tstyche"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/satunnaisuus/distill.git"
  },
  "keywords": [],
  "author": "satunnaisuus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/satunnaisuus/distill/issues"
  },
  "homepage": "https://github.com/satunnaisuus/distill#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "tsdown": "^0.21.10",
    "tstyche": "^7.1.0",
    "typescript": "^6.0.3"
  }
}
