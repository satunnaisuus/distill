{
  "name": "distill-monorepo",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm --filter @satunnaisuus/distill build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "pnpm --filter @satunnaisuus/distill typecheck",
    "test": "pnpm --filter @satunnaisuus/distill test",
    "test:unit": "pnpm --filter @satunnaisuus/distill test:unit",
    "test:types": "pnpm --filter @satunnaisuus/distill test:types",
    "coverage": "pnpm --filter @satunnaisuus/distill coverage",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "lefthook": "^2.1.6"
  }
}
